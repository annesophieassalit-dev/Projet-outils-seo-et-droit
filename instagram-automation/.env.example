# ══════════════════════════════════════════════════════
#  Instagram Automation — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
# ══════════════════════════════════════════════════════

# ── Instagram Graph API (Meta) ─────────────────────────
# Voir SETUP_META_API.md pour obtenir ces valeurs
INSTAGRAM_ACCESS_TOKEN=votre_token_acces_meta_ici
INSTAGRAM_ACCOUNT_ID=votre_id_compte_instagram_ici

# ── Cloudinary (hébergement temporaire des images) ─────
# Créez un compte gratuit sur https://cloudinary.com
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
